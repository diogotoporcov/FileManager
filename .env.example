# PostgreSQL
POSTGRES_IMAGE=pgvector/pgvector:pg18
POSTGRES_DB=filemanager
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=replace_me:urlsafe:24
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PORT_POSTGRES=5432

# MinIO / S3
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace_me:urlsafe:24
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=filemanager
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=replace_me:urlsafe:24
S3_BUCKET_NAME=filemanager
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=60
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001

# Kafka / Redpanda
REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v25.3.11
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
FILE_PROCESSING_CHECKSUM_TOPIC=file.processing.checksum
FILE_PROCESSING_IMAGE_TOPIC=file.processing.image
FILE_PROCESSING_AUDIO_TOPIC=file.processing.audio
WORKER_TOPICS=file.processing.checksum,file.processing.image,file.processing.audio
KAFKA_TOPIC_DLQ=file.processing.requested.dlq
KAFKA_CONSUMER_GROUP_ID=filemanager-worker-group
PORT_REDPANDA=9092

# Keycloak / JWT
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_me:urlsafe:24
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/filemanager
AUTH_PROVIDER_NAME=keycloak
AUTH_EMAIL_CLAIM=email
AUTH_FIRST_NAME_CLAIM=given_name
AUTH_LAST_NAME_CLAIM=family_name
AUTH_EMAIL_VERIFIED_CLAIM=email_verified
AUTH_REQUIRE_VERIFIED_EMAIL=true
AUTH_REQUIRED_AUDIENCES=filemanager-api
PORT_KEYCLOAK=8082

# Internal API token
INTERNAL_API_TOKEN=replace_me:hex:64

# API
API_IMAGE=filemanager-api:local
PORT_API=8081
MAX_UPLOAD_FILE_SIZE=512MB
MAX_UPLOAD_REQUEST_SIZE=512MB
PROCESSING_CHECKSUM_ENABLED=true
PROCESSING_IMAGE_PHASH_ENABLED=true
PROCESSING_IMAGE_EMBEDDING_ENABLED=false
PROCESSING_AUDIO_FINGERPRINT_ENABLED=true
DUPLICATE_DETECTION_EXACT_ENABLED=true
DUPLICATE_DETECTION_IMAGE_PHASH_ENABLED=true
DUPLICATE_DETECTION_IMAGE_EMBEDDING_ENABLED=false
DUPLICATE_DETECTION_AUDIO_FINGERPRINT_ENABLED=true
PROCESSABLE_IMAGE_MIME_TYPES=image/apng,image/avif,image/bmp,image/gif,image/icns,image/jp2,image/jpeg,image/mpo,image/palm,image/png,image/sgi,image/tiff,image/vnd.adobe.photoshop,image/webp,image/x-icon,image/x-pcx,image/x-portable-anymap,image/x-tga,image/xbm,image/xpm
PROCESSABLE_AUDIO_MIME_TYPES=audio/mpeg,audio/mp3,audio/wav,audio/x-wav,audio/wave,audio/vnd.wave,audio/flac,audio/x-flac,audio/ogg,audio/aac,audio/mp4,audio/x-m4a,audio/webm,audio/opus,audio/matroska,audio/x-matroska,audio/ac3,audio/3gpp,audio/3gpp2,audio/x-aiff,audio/aiff
PHASH_THRESHOLD=10
PHASH_MAX_CANDIDATES=5000
USER_STORAGE_QUOTA_BYTES=16106127360
FILE_TRANSFER_PRESIGNED_DOWNLOAD_ENABLED=true
FILE_TRANSFER_PRESIGNED_DOWNLOAD_TTL=5m
SPRING_JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false

# Gateway
GATEWAY_IMAGE=filemanager-gateway:local
PORT_GATEWAY=8080
FILEMANAGER_API_BASE_URL=http://api:8081
GATEWAY_MAX_REQUEST_SIZE=100MB
GATEWAY_CONNECT_TIMEOUT=5000
GATEWAY_RESPONSE_TIMEOUT=60s

# File processor
FILE_PROCESSOR_IMAGE=filemanager-file-processor:local
WORKER_CONSUMER_ENABLED=true
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=1
WORKER_RETRY_BACKOFF_MULTIPLIER=2
WORKER_CHECKSUM_ENABLED=true
WORKER_IMAGE_PHASH_ENABLED=true
WORKER_IMAGE_EMBEDDING_ENABLED=false
WORKER_AUDIO_ENABLED=true
WORKER_AUDIO_FINGERPRINT_ENABLED=true
WORKER_AUDIO_MAX_FILE_BYTES=268435456
WORKER_AUDIO_MAX_DURATION_SECONDS=1800
WORKER_AUDIO_FINGERPRINT_LENGTH_SECONDS=120
WORKER_AUDIO_SUBPROCESS_TIMEOUT_SECONDS=30
WORKER_AUDIO_MAX_FINGERPRINT_CHARS=32768
METADATA_API_BASE_URL=http://api:8081
METADATA_API_TIMEOUT_SECONDS=10
METRICS_ENABLED=true
LOG_LEVEL=INFO

# Embedding inference
EMBEDDING_PROCESSOR_ENABLED=false
EMBEDDING_ENABLED=false
EMBEDDING_MODEL_NAME=openai/clip-vit-large-patch14
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSION=768
EMBEDDING_SIMILARITY_THRESHOLD=0.20
EMBEDDING_MAX_CANDIDATES=5000
EMBEDDING_MAX_IMAGE_BYTES=104857600
TRITON_BASE_IMAGE=nvcr.io/nvidia/tritonserver:25.10-py3
TRITON_IMAGE=filemanager-embedding-inference:local
TRITON_GRPC_URL=embedding-inference:8001
TRITON_MODEL_NAME=image_embedding
TRITON_MODEL_VERSION=1
TRITON_INPUT_TENSOR_NAME=pixel_values
TRITON_OUTPUT_TENSOR_NAME=image_embeds
TRITON_INFERENCE_TIMEOUT_SECONDS=10
TRITON_GPUS=all
PORT_TRITON_HTTP=8000
PORT_TRITON_GRPC=8001
PORT_TRITON_METRICS=8002
